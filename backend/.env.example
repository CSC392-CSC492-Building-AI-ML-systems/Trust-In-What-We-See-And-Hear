APP_NAME="Trust In What We See And Hear API"
ENVIRONMENT=development

# Supabase project URL and publishable (anon) key, from Project Settings > API Keys.
# Required to verify bearer tokens on authenticated routes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_..., or the legacy service_role key), from Project Settings > API
# Keys. Required by routes that read or write the database. It bypasses Row Level Security: keep it
# out of the frontend and out of git.
SUPABASE_SECRET_KEY=

# Version of the privacy policy users accept during onboarding. Change it when the policy changes.
PRIVACY_POLICY_VERSION=2026-11
