APP_NAME="Trust In What We See And Hear API"
ENVIRONMENT=development

# Supabase project URL and publishable (anon) key, from Project Settings > API Keys.
# Required to verify bearer tokens on authenticated routes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_..., or the legacy service_role key), from Project Settings > API
# Keys. Required by routes that read or write the database. It bypasses Row Level Security: keep it
# out of the frontend and out of git.
SUPABASE_SECRET_KEY=

# Version of the privacy policy users accept during onboarding. Change it when the policy changes.
PRIVACY_POLICY_VERSION=2026-11

# Minutes an accepted consent stays usable if it is not used. Each consent covers one call.
CONSENT_VALID_MINUTES=1440

# Voice reference samples: private Storage buckets and upload limits.
VOICE_SAMPLES_BUCKET=voice-samples
VOICE_MODELS_BUCKET=voice-models
# Also caps every request body (plus 64 KiB for the form around the file).
VOICE_SAMPLE_MAX_BYTES=10485760
# Chatterbox needs more than 5 seconds and uses up to the first 15.
VOICE_SAMPLE_MIN_SECONDS=15
VOICE_SAMPLE_MAX_SECONDS=60
# Recordings quieter than this on average (RMS, dB relative to full scale) are rejected as silent.
VOICE_SAMPLE_MIN_DBFS=-50
# Uploads are converted to mono WAV at this sample rate.
VOICE_SAMPLE_RATE=24000
# ffmpeg decodes uploaded audio: a name on PATH or a full path.
FFMPEG_PATH=ffmpeg

# Voice pipeline (voice-pipeline/BACKEND.md). Calls cannot start without both.
# WebSocket base address the browser connects to, e.g. wss://pipeline.example
PIPELINE_WS_URL=
# Shared secret the pipeline sends to /api/v1/internal; its PIPELINE_BACKEND_SECRET. Keep it out of git.
PIPELINE_BACKEND_SECRET=
# Supabase's address as the voice pipeline reaches it, when not SUPABASE_URL
# (a local Supabase behind voice-pipeline/dev/tunnels.py). Leave empty otherwise.
PIPELINE_SUPABASE_URL=
# Seconds the call's one-time token can be claimed by the pipeline.
CALL_CLAIM_VALID_SECONDS=120
# Seconds the signed link to the persona's voice sample works.
CALL_VOICE_URL_VALID_SECONDS=300
# A call in progress this many seconds after it started, without a result, is marked failed.
CALL_RESULT_TIMEOUT_SECONDS=900
