APP_NAME="Trust In What We See And Hear API"
ENVIRONMENT=development

# Supabase project URL and publishable (anon) key, from Project Settings > API Keys.
# Required to verify bearer tokens on authenticated routes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_..., or the legacy service_role key), from Project Settings > API
# Keys. Required by routes that read or write the database. It bypasses Row Level Security: keep it
# out of the frontend and out of git.
SUPABASE_SECRET_KEY=

# Version of the privacy policy users accept during onboarding. Change it when the policy changes.
PRIVACY_POLICY_VERSION=2026-11

# Minutes an accepted consent stays usable if it is not used. Each consent covers one call.
CONSENT_VALID_MINUTES=1440

# Voice reference samples: private Storage buckets and upload limits (placeholders until the voice
# pipeline confirms what it needs).
VOICE_SAMPLES_BUCKET=voice-samples
VOICE_MODELS_BUCKET=voice-models
# Also caps every request body (plus 64 KiB for the form around the file).
VOICE_SAMPLE_MAX_BYTES=10485760
VOICE_SAMPLE_MIN_SECONDS=5
VOICE_SAMPLE_MAX_SECONDS=60
# Uploads are converted to mono WAV at this sample rate.
VOICE_SAMPLE_RATE=24000
# ffmpeg decodes uploaded audio: a name on PATH or a full path.
FFMPEG_PATH=ffmpeg
