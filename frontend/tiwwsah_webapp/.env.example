# Copy to .env.local, or let `npm run setup` at the repository root create it. The values below
# point at the local Supabase stack and the backend on port 8000. For the hosted project, use its
# URL and publishable key from Project Settings > API Keys instead.

# Supabase API URL and publishable key. `npm run supabase status` at the repository root prints
# both for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# FastAPI backend base URL, without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000
